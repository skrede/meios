<robot name="probe" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="outer" params="**b">
    <link name="l">
      <xacro:insert_block name="b"/>
    </link>
  </xacro:macro>
  <xacro:macro name="inner" params="*a">
    <xacro:outer>
      <xacro:insert_block name="a"/>
    </xacro:outer>
  </xacro:macro>
  <xacro:inner>
    <wrap>
      <xacro:attribute name="k" value="v"/>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <box size="1.0 1.0 1.0"/>
        </geometry>
      </visual>
    </wrap>
  </xacro:inner>
</robot>
