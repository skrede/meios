<robot name="probe" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="taker" params="on **body">
    <xacro:if value="${on}"><xacro:insert_block name="body"/></xacro:if>
  </xacro:macro>
  <xacro:taker on="false"><link name="${undefined_name_nobody_bound}"/></xacro:taker>
  <link name="only"/>
</robot>
