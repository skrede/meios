<?xml version="1.0"?>
<robot name="branched_all_joints">
  <link name="base_link"/>
  <link name="torso"/>
  <link name="arm"/>
  <link name="wheel"/>
  <link name="slider"/>
  <link name="free_body"/>
  <link name="plane_body"/>

  <joint name="base_to_torso" type="fixed">
    <parent link="base_link"/>
    <child link="torso"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <joint name="torso_to_arm" type="revolute">
    <parent link="torso"/>
    <child link="arm"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="arm_to_wheel" type="continuous">
    <parent link="arm"/>
    <child link="wheel"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="torso_to_slider" type="prismatic">
    <parent link="torso"/>
    <child link="slider"/>
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.5" effort="20.0" velocity="0.2"/>
  </joint>

  <joint name="base_to_free" type="floating">
    <parent link="base_link"/>
    <child link="free_body"/>
    <origin xyz="0 -0.2 0" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_plane" type="planar">
    <parent link="base_link"/>
    <child link="plane_body"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
