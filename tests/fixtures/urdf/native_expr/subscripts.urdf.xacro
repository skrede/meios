<?xml version="1.0"?>
<robot name="subscripts" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="params_file" value="params.yaml"/>
  <xacro:property name="params" value="${xacro.load_yaml(params_file)}"/>
  <xacro:property name="name" value="base"/>
  <xacro:property name="type" value="visual"/>

  <xacro:macro name="shell" params="files kind">
    <link name="${kind}">
      <visual>
        <geometry>
          <mesh filename="package://${files[name][kind]['mesh']['package']}/${files[name][kind]['mesh']['path']}"/>
        </geometry>
      </visual>
    </link>
  </xacro:macro>

  <xacro:shell files="${params['mesh_files']}" kind="${type}"/>

  <xacro:if value="${params['joint_limits']['wrist_3']['continuous']}">
    <joint name="wrist_3_joint" type="continuous"/>
  </xacro:if>
  <xacro:unless value="${params['joint_limits']['wrist_3']['continuous']}">
    <joint name="wrist_3_joint" type="revolute"/>
  </xacro:unless>
</robot>
