<?xml version="1.0"?>
<robot name="members" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="params_file" value="params.yaml"/>
  <xacro:property name="params" value="${xacro.load_yaml(params_file)}"/>
  <xacro:property name="part" value="visual"/>

  <xacro:macro name="shell" params="files kind">
    <link name="${kind}">
      <visual>
        <geometry>
          <mesh filename="package://${files.base.visual.mesh.package}/${files.base[kind].mesh.path}"/>
        </geometry>
      </visual>
    </link>
  </xacro:macro>

  <xacro:shell files="${params.mesh_files}" kind="${part}"/>

  <xacro:if value="${params.joint_limits.wrist_3.continuous}">
    <joint name="wrist_3_joint" type="continuous"/>
  </xacro:if>
</robot>
