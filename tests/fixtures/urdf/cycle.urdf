<?xml version="1.0"?>
<robot name="cycle">
  <link name="a"/>
  <link name="b"/>
  <link name="c"/>

  <joint name="a_to_b" type="fixed">
    <parent link="a"/>
    <child link="b"/>
  </joint>
  <joint name="b_to_c" type="fixed">
    <parent link="b"/>
    <child link="c"/>
  </joint>
  <joint name="c_to_a" type="fixed">
    <parent link="c"/>
    <child link="a"/>
  </joint>
</robot>
