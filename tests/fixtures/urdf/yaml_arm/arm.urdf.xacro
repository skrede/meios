<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="yaml_arm">
  <xacro:arg name="config_path" default=""/>
  <xacro:property name="config_file" value="$(arg config_path)"/>
  <xacro:property name="config" value="${xacro.load_yaml(config_file)}"/>
  <xacro:property name="joints" value="${config['joints']}"/>
  <xacro:property name="shoulder" value="${joints['shoulder']}"/>

  <link name="base_link"/>
  <link name="shoulder_link"/>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 ${shoulder['height']}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${shoulder['lower']}" upper="${shoulder['upper']}"
           effort="${shoulder['effort']}" velocity="${shoulder['velocity']}"/>
  </joint>
</robot>
