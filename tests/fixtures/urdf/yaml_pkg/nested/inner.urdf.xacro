<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="yaml_pkg_inner">
  <xacro:property name="config" value="${xacro.load_yaml('inner-config.yaml')}"/>
  <xacro:property name="shoulder" value="${config['joints']['shoulder']}"/>

  <link name="shoulder_link"/>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 ${shoulder['height']}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${shoulder['lower']}" upper="${shoulder['upper']}"
           effort="${shoulder['effort']}" velocity="${shoulder['velocity']}"/>
  </joint>
</robot>
