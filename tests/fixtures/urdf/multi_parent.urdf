<?xml version="1.0"?>
<robot name="multi_parent">
  <link name="base"/>
  <link name="arm"/>
  <link name="shared"/>

  <joint name="base_to_arm" type="fixed">
    <parent link="base"/>
    <child link="arm"/>
  </joint>
  <joint name="base_to_shared" type="fixed">
    <parent link="base"/>
    <child link="shared"/>
  </joint>
  <joint name="arm_to_shared" type="fixed">
    <parent link="arm"/>
    <child link="shared"/>
  </joint>
</robot>
