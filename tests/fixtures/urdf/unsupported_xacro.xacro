<?xml version="1.0"?>
<robot name="unsupported_xacro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="params" value="${load_yaml('params.yaml')}"/>
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${params['size']} 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
</robot>
