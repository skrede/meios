<?xml version="1.0"?>
<robot name="relative_asset_absent">
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="absent_meshes/base.stl"/>
      </geometry>
    </visual>
  </link>
  <link name="upper_link">
    <visual>
      <geometry>
        <mesh filename="absent_meshes/upper.stl"/>
      </geometry>
    </visual>
  </link>
  <joint name="base_to_upper" type="fixed">
    <parent link="base_link"/>
    <child link="upper_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>
</robot>
