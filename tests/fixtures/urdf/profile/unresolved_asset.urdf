<?xml version="1.0"?>
<robot name="unresolved_asset">
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://absent_pkg/meshes/base.stl"/>
      </geometry>
    </visual>
  </link>
  <link name="upper_link">
    <visual>
      <geometry>
        <mesh filename="package://other_absent_pkg/meshes/upper.stl"/>
      </geometry>
    </visual>
  </link>
  <joint name="base_to_upper" type="fixed">
    <parent link="base_link"/>
    <child link="upper_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>
</robot>
