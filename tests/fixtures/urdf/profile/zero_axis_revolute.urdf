<?xml version="1.0"?>
<robot name="zero_axis_revolute">
  <link name="base_link"/>
  <link name="arm_link"/>
  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <axis xyz="0 0 0"/>
    <limit effort="10" velocity="1" lower="-1" upper="1"/>
  </joint>
</robot>
