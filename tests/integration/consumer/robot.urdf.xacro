<?xml version="1.0"?>
<robot name="vendored_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="shoulder_height" value="0.25"/>

  <link name="base_link"/>
  <link name="shoulder_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="brushed_aluminium"/>
    </visual>
  </link>
  <link name="tool_link"/>

  <joint name="base_to_shoulder" type="fixed">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 ${shoulder_height}" rpy="0 0 0"/>
  </joint>

  <joint name="shoulder_to_tool" type="fixed">
    <parent link="shoulder_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
</robot>
