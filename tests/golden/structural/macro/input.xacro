<robot name="m" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="framed" params="prefix size:=0.1 *shape **extra">
    <link name="${prefix}_link">
      <visual>
        <geometry>
          <box size="${size} ${size} ${size}"/>
        </geometry>
        <xacro:insert_block name="shape"/>
      </visual>
      <xacro:insert_block name="extra"/>
    </link>
  </xacro:macro>
  <xacro:framed prefix="arm">
    <origin xyz="0 0 0"/>
    <group>
      <mass value="1.0"/>
      <inertia/>
    </group>
  </xacro:framed>
</robot>
