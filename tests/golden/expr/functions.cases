# expr <TAB> expected canonical output (CPython str()), machine-verified.
# The math constant and the square root.
pi	3.141592653589793
sqrt(4)	2.0
sqrt(2)	1.4142135623730951
# Angle conversions round-trip pi.
radians(180)	3.141592653589793
degrees(pi)	180.0
# floor and ceil return integers.
floor(2.7)	2
ceil(2.1)	3
floor(-2.5)	-3
# abs preserves the operand's type.
abs(-3)	3
abs(-3.5)	3.5
# min and max return the selected element unchanged.
min(1,2)	1
max(3,7)	7
max(1.5,2)	2
# Trigonometry and the two-argument arctangent.
sin(0)	0.0
cos(0)	1.0
atan2(0,1)	0.0
