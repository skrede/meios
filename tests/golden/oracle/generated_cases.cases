# id <TAB> family <TAB> text <TAB> upstream <TAB> refusal. A seeded, fixed-size set of
# include filenames, dollar shapes and macro specifications, each written into its
# family's template below and rendered by the pinned reference as doc/case.xacro beside
# tests/fixtures/xacro/generated, whose R directory is the only package root. The text
# and refusal columns escape a backslash, a tab and a newline as \\, \t and \n. A
# slot the escaped line names is written into an attribute with &, < and " escaped,
# and every other slot is markup written as it is. A multi-slot text separates its
# fields with a tab, in the order its slots line names. The upstream column is
# REFUSED, or the name of every rendered link element in document order, each
# double-quoted with a quote or backslash inside it escaped, joined by a space, or -
# where none rendered.
# The staged package root reads @ROOT@ and the staged document directory @DOC@. The
# refusal column carries a refusal's first line and is not compared.
# seed 0x6d65696f73
# count include 200
# count span 200
# count macro 200
# escaped TEXT SPEC
# slots include TEXT
# slots span TEXT
# slots macro SPEC ATTRS CHILDREN BODY
# template include <robot name="g" xmlns:xacro="http://www.ros.org/wiki/xacro"><xacro:property name="x" value="vx"/><xacro:property name="e" value=""/><xacro:property name="pk" value="p"/><xacro:property name="sp" value=" p"/><xacro:include filename="@TEXT@"/></robot>
# template span <robot name="g" xmlns:xacro="http://www.ros.org/wiki/xacro"><xacro:property name="x" value="vx"/><xacro:property name="e" value=""/><xacro:property name="pk" value="p"/><xacro:property name="sp" value=" p"/><xacro:arg name="y" default="Y"/><link name="@TEXT@"/></robot>
# template macro <robot name="g" xmlns:xacro="http://www.ros.org/wiki/xacro"><xacro:property name="x" value="vx"/><xacro:property name="b" value="ob"/><xacro:arg name="y" default="Y"/><xacro:macro name="m" params="@SPEC@">@BODY@</xacro:macro><xacro:m @ATTRS@>@CHILDREN@</xacro:m></robot>
